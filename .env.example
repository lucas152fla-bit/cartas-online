# Copie para .env e ajuste. Em produção, defina pelo painel/segredos do host.

# Porta e interface (o host normalmente injeta PORT automaticamente)
PORT=3000
HOST=0.0.0.0

# Assinatura dos tokens de login. Gere um valor aleatório e NUNCA comite.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Defina 1 para exigir conta cadastrada e desligar o login de convidado (__dev).
# Recomendado quando o link for público na internet.
DISABLE_GUEST=

# Caminho do banco (padrão: data/cartas.db). Em container, aponte para o volume.
# DB_PATH=/app/data/cartas.db

# --- Persistência com Litestream (Backblaze B2 / S3-compatível) ---
# Sem estas variáveis o app sobe normal, mas o SQLite fica efêmero no host.
LITESTREAM_ENDPOINT=          # ex.: https://s3.us-west-004.backblazeb2.com
LITESTREAM_BUCKET=            # ex.: cartas-online-db
LITESTREAM_REGION=            # ex.: us-west-004 (B2) ou auto (R2)
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
